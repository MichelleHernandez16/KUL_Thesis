mutate(
is_acl = grepl("ACL|cruciate|ligament",
tolower(injury_type)),
season_year = as.numeric(season_simple)
) %>%
filter(is_acl) %>%
left_join(
surv_df_liga %>% select(player_url,
career_end_year = debut_year,
career_length,
event,
debut_year_num),
by = "player_url"
) %>%
mutate(
# Approximate retirement season
retirement_year = debut_year_num + career_length,
# Years between ACL and retirement
years_to_retirement = retirement_year - season_year
) %>%
filter(event == 1,  # Only retired players
years_to_retirement >= 0)  # ACL before retirement
# Distribution of time from ACL to retirement
summary(acl_retirement_lag$years_to_retirement)
hist(acl_retirement_lag$years_to_retirement,
breaks = 20,
main = "Years Between ACL Injury and Retirement",
xlab = "Years",
col  = "steelblue")
abline(v = 3, col = "red", lty = 2, lwd = 2)
# Red line = your current 3-year cutoff
# What % of ACL retirements are within 3 years?
cat("ACL retirements within 3 years:",
round(mean(acl_retirement_lag$years_to_retirement <= 3)
* 100, 1), "%")
cat("ACL retirements within 5 years:",
round(mean(acl_retirement_lag$years_to_retirement <= 5)
* 100, 1), "%")
summary(acl_retirement_lag$years_to_retirement)
td_df_full <- td_df_full %>%
mutate(
event_type_3 = case_when(
# Censored
event_dynamic == 0 ~ 0L,
# Type 1: Natural/Performance retirement
# No injury signal in the final 2 seasons
event_dynamic == 1 &
!had_serious_last_2y &
!relapse_last_2y ~ 1L,
# Type 2: Chronic/Relapse pathway
# Recurring injury pattern leading to retirement
# Most theoretically coherent — cumulative damage
event_dynamic == 1 &
relapse_last_2y ~ 2L,
# Type 3: Acute serious injury pathway
# Single serious injury event without relapse pattern
event_dynamic == 1 &
had_serious_last_2y &
!relapse_last_2y ~ 3L
)
)
# Check counts
td_df_full %>%
filter(is_last_row) %>%
count(event_type_3) %>%
mutate(
type = case_when(
event_type_3 == 0 ~ "Censored",
event_type_3 == 1 ~ "Natural/Performance",
event_type_3 == 2 ~ "Chronic/Relapse",
event_type_3 == 3 ~ "Acute serious injury"
),
pct = round(n/sum(n)*100, 1)
) %>%
print()
# Create a career-level ACL flag
acl_career <- eda_injuries %>%
mutate(is_acl = grepl("ACL|cruciate|ligament",
tolower(injury_type))) %>%
group_by(player_url) %>%
summarise(
ever_had_acl     = any(is_acl),
n_acl_injuries   = sum(is_acl),
had_multiple_acl = sum(is_acl) > 1,  # Re-rupture
.groups = "drop"
)
cat("Players with ACL history:",
sum(acl_career$ever_had_acl))
cat("Players with multiple ACL:",
sum(acl_career$had_multiple_acl))
# Join to fg_data for use as covariate
fg_data <- td_df_full %>%
filter(is_last_row) %>%
left_join(acl_career, by = "player_url") %>%
mutate(
ever_had_acl     = replace_na(ever_had_acl, FALSE),
had_multiple_acl = replace_na(had_multiple_acl, FALSE)
)
# ==============================================================================
# STEP 1: Finalise fg_data
# ==============================================================================
fg_data <- td_df_full %>%
filter(is_last_row) %>%
left_join(acl_career, by = "player_url") %>%
mutate(
ever_had_acl     = replace_na(ever_had_acl, FALSE),
had_multiple_acl = replace_na(had_multiple_acl, FALSE),
# Numeric versions for crr()
pos_defender  = as.numeric(position_simple == "Defender"),
pos_gk        = as.numeric(position_simple == "Goalkeeper"),
pos_mid       = as.numeric(position_simple == "Midfield"),
national_yes  = as.numeric(National_team == "Yes"),
serious_inj   = as.numeric(had_serious_last_2y),
relapse_2y    = as.numeric(relapse_last_2y),
acl_ever      = as.numeric(ever_had_acl),
acl_multiple  = as.numeric(had_multiple_acl),
high_load_num = as.numeric(high_load)
)
# Verify no NAs in key variables
cat("NAs in event_type_3:", sum(is.na(fg_data$event_type_3)))
cat("NAs in age_stop:",     sum(is.na(fg_data$age_stop)))
cat("Total rows:",          nrow(fg_data))
# Overall cumulative incidence by cause
ci_overall <- cuminc(
ftime   = fg_data$age_stop,
fstatus = fg_data$event_type_3,
cencode = 0
)
# Print Gray's test — tests if causes differ significantly
print(ci_overall$Tests)
# Plot overall
par(mfrow = c(1, 1))
plot(ci_overall,
xlab    = "Age",
ylab    = "Cumulative Incidence",
main    = "Cumulative Incidence of Career Exit by Pathway",
lwd     = 2,
col     = c("steelblue", "firebrick", "darkgreen"),
lty     = c(1, 1, 1),
curvlab = c("Natural/Performance",
"Chronic/Relapse",
"Acute Serious Injury"))
legend("topleft",
legend = c("Natural/Performance",
"Chronic/Relapse",
"Acute Serious Injury"),
col    = c("steelblue", "firebrick", "darkgreen"),
lwd    = 2, lty = 1, cex = 0.8)
# By position
ci_position <- cuminc(
ftime   = fg_data$age_stop,
fstatus = fg_data$event_type_3,
group   = fg_data$position_simple,
cencode = 0
)
print(ci_position$Tests)
# By national team status
ci_national <- cuminc(
ftime   = fg_data$age_stop,
fstatus = fg_data$event_type_3,
group   = fg_data$National_team,
cencode = 0
)
print(ci_national$Tests)
# ==============================================================================
# STEP 3: Fine-Gray Subdistribution Hazard Models
# ==============================================================================
# Covariate matrix — same for all three models
covmat <- as.matrix(fg_data %>%
select(pos_defender, pos_gk, pos_mid,
national_yes, debut_age_num,
matches_played, serious_inj,
relapse_2y, acl_ever,
acl_multiple, high_load_num))
# ── Cause 1: Natural/Performance Retirement ───────────────────────────────────
fg_natural <- crr(
ftime    = fg_data$age_stop,
fstatus  = fg_data$event_type_3,
cov1     = covmat,
failcode = 1,
cencode  = 0
)
cat("\n=== Fine-Gray: Natural/Performance Retirement ===\n")
summary(fg_natural)
# ── Cause 2: Chronic/Relapse Pathway ─────────────────────────────────────────
fg_relapse <- crr(
ftime    = fg_data$age_stop,
fstatus  = fg_data$event_type_3,
cov1     = covmat,
failcode = 2,
cencode  = 0
)
cat("\n=== Fine-Gray: Chronic/Relapse Pathway ===\n")
summary(fg_relapse)
# ── Cause 3: Acute Serious Injury ─────────────────────────────────────────────
fg_acute <- crr(
ftime    = fg_data$age_stop,
fstatus  = fg_data$event_type_3,
cov1     = covmat,
failcode = 3,
cencode  = 0
)
cat("\n=== Fine-Gray: Acute Serious Injury ===\n")
summary(fg_acute)
# ==============================================================================
# STEP 4: Extract Results Into Comparison Table
# ==============================================================================
extract_fg_results <- function(model, cause_name) {
coefs <- summary(model)$coef
data.frame(
Cause     = cause_name,
Variable  = rownames(coefs),
HR        = round(exp(coefs[, "coef"]), 3),
CI_lower  = round(exp(coefs[, "coef"] -
1.96 * coefs[, "se(coef)"]), 3),
CI_upper  = round(exp(coefs[, "coef"] +
1.96 * coefs[, "se(coef)"]), 3),
P_value   = round(coefs[, "p-value"], 4)
)
}
results_table <- bind_rows(
extract_fg_results(fg_natural, "Natural/Performance"),
extract_fg_results(fg_relapse, "Chronic/Relapse"),
extract_fg_results(fg_acute,   "Acute Serious Injury")
)
print(results_table)
# Cause 1: Natural retirement
cox_cause1 <- coxph(
Surv(time = age_start, time2 = age_stop,
event = ifelse(event_type_3 == 1, 1, 0)) ~
position_simple + strata(region) +
National_team + pspline(debut_age_num) +
matches_played + relapse_last_2y +
ever_had_acl + high_load +
cluster(player_url),
data = td_df_full,
id   = player_url
)
# Cause 2: Chronic/Relapse
cox_cause2 <- coxph(
Surv(time = age_start, time2 = age_stop,
event = ifelse(event_type_3 == 2, 1, 0)) ~
position_simple + strata(region) +
National_team + pspline(debut_age_num) +
matches_played + relapse_last_2y +
ever_had_acl + high_load +
cluster(player_url),
data = td_df_full,
id   = player_url
)
# Cause 3: Acute serious injury
cox_cause3 <- coxph(
Surv(time = age_start, time2 = age_stop,
event = ifelse(event_type_3 == 3, 1, 0)) ~
position_simple + strata(region) +
National_team + pspline(debut_age_num) +
matches_played + relapse_last_2y +
ever_had_acl + high_load +
cluster(player_url),
data = td_df_full,
id   = player_url
)
acl_career <- eda_injuries %>%
mutate(
is_acl = grepl("ACL|cruciate|ligament",
tolower(injury_type))
) %>%
group_by(player_url) %>%
summarise(
ever_had_acl     = any(is_acl),
n_acl_injuries   = sum(is_acl),
had_multiple_acl = sum(is_acl) > 1,
.groups = "drop"
)
# Verify
names(acl_career)
cat("Rows:", nrow(acl_career))
cat("Players with ACL:", sum(acl_career$ever_had_acl))
cat("Players with multiple ACL:",
sum(acl_career$had_multiple_acl))
# Then join
td_df_full <- td_df_full %>%
left_join(
acl_career %>%
select(player_url, ever_had_acl,
had_multiple_acl, n_acl_injuries),
by = "player_url"
) %>%
mutate(
ever_had_acl     = replace_na(ever_had_acl, FALSE),
had_multiple_acl = replace_na(had_multiple_acl, FALSE),
n_acl_injuries   = replace_na(n_acl_injuries, 0)
)
# Final verification
cat("ever_had_acl in td_df_full:",
"ever_had_acl" %in% names(td_df_full))
cat("Rows in td_df_full:", nrow(td_df_full))
cat("Distribution of ever_had_acl:")
table(td_df_full$ever_had_acl)
# Remove variables used to DEFINE the event types
# They cannot be covariates when they define the outcome
covmat_clean <- as.matrix(fg_data %>%
select(
pos_defender, pos_gk, pos_mid,
national_yes,
debut_age_num,
matches_played,
# serious_inj  ← REMOVE — defines event_type_3
# relapse_2y   ← REMOVE — defines event_type_3
acl_ever,
acl_multiple,
high_load_num
))
# Rerun all three Fine-Gray models
fg_natural <- crr(
ftime    = fg_data$age_stop,
fstatus  = fg_data$event_type_3,
cov1     = covmat_clean,
failcode = 1,
cencode  = 0
)
fg_relapse <- crr(
ftime    = fg_data$age_stop,
fstatus  = fg_data$event_type_3,
cov1     = covmat_clean,
failcode = 2,
cencode  = 0
)
fg_acute <- crr(
ftime    = fg_data$age_stop,
fstatus  = fg_data$event_type_3,
cov1     = covmat_clean,
failcode = 3,
cencode  = 0
)
# Check convergence
cat("Natural converged:", fg_natural$converged)
cat("Relapse converged:", fg_relapse$converged)
cat("Acute converged:  ", fg_acute$converged)
# Print summaries
cat("\n=== Fine-Gray: Natural/Performance ===\n")
summary(fg_natural)
cat("\n=== Fine-Gray: Chronic/Relapse ===\n")
summary(fg_relapse)
cat("\n=== Fine-Gray: Acute Serious Injury ===\n")
summary(fg_acute)
# Cause 1: Natural retirement
cox_cause1 <- coxph(
Surv(time = age_start, time2 = age_stop,
event = ifelse(event_type_3 == 1, 1, 0)) ~
position_simple + strata(region) +
National_team + pspline(debut_age_num) +
matches_played + ever_had_acl +
high_load + cluster(player_url),
data = td_df_full,
id   = player_url
)
# Cause 2: Chronic/Relapse
cox_cause2 <- coxph(
Surv(time = age_start, time2 = age_stop,
event = ifelse(event_type_3 == 2, 1, 0)) ~
position_simple + strata(region) +
National_team + pspline(debut_age_num) +
matches_played + ever_had_acl +
high_load + cluster(player_url),
data = td_df_full,
id   = player_url
)
# Cause 3: Acute serious injury
cox_cause3 <- coxph(
Surv(time = age_start, time2 = age_stop,
event = ifelse(event_type_3 == 3, 1, 0)) ~
position_simple + strata(region) +
National_team + pspline(debut_age_num) +
matches_played + ever_had_acl +
high_load + cluster(player_url),
data = td_df_full,
id   = player_url
)
cat("\n=== Cause-Specific Cox: Natural ===\n")
summary(cox_cause1)
cat("\n=== Cause-Specific Cox: Chronic/Relapse ===\n")
summary(cox_cause2)
cat("\n=== Cause-Specific Cox: Acute Injury ===\n")
summary(cox_cause3)
# Test PH for Fine-Gray models
# Using Schoenfeld-type residuals via riskRegression package
install.packages('prodlim')
# Load just the Hist function
Hist <- riskRegression::Hist
ph_cause3 <- cox.zph(cox_cause3)
cat("\n=== PH Test: Natural Retirement ===\n")
print(ph_cause1)
cat("\n=== PH Test: Chronic/Relapse ===\n")
print(ph_cause2)
cat("\n=== PH Test: Acute Injury ===\n")
print(ph_cause3)
------------------------------------------------------------------------------
# STEP 2: Transition Counts (Multi-State Setup)
# ------------------------------------------------------------------------------
# Create state variables
td_df_full <- td_df_full %>%
arrange(player_url, season_year) %>%
group_by(player_url) %>%
mutate(
state = case_when(
event_dynamic == 1 & is_last_row ~ 2,  # Retired
serious_injuries > 0 ~ 1,              # Seriously injured
TRUE ~ 0                                # Active
),
prev_state = lag(state, n = 1, default = 0),
valid_transition = !is.na(lag(state))
) %>%
ungroup()
print(ph_cause3)
------------------------------------------------------------------------------
# STEP 2: Transition Counts (Multi-State Setup)
# ------------------------------------------------------------------------------
# Create state variables
td_df_full <- td_df_full %>%
arrange(player_url, season_year) %>%
group_by(player_url) %>%
mutate(
state = case_when(
event_dynamic == 1 & is_last_row ~ 2,  # Retired
serious_injuries > 0 ~ 1,              # Seriously injured
TRUE ~ 0                                # Active
),
prev_state = lag(state, n = 1, default = 0),
valid_transition = !is.na(lag(state))
) %>%
ungroup()
# Count transitions
transitions_liga <- td_df_full %>%
filter(valid_transition) %>%
count(prev_state, state) %>%
mutate(
transition = case_when(
prev_state == 0 & state == 0 ~ "Active → Active",
prev_state == 0 & state == 1 ~ "Active → Injured",
prev_state == 0 & state == 2 ~ "Active → Retired",
prev_state == 1 & state == 0 ~ "Injured → Recovered",
prev_state == 1 & state == 1 ~ "Injured → Still Injured",
prev_state == 1 & state == 2 ~ "Injured → Retired"
)
)
cat("\n=== LA LIGA TRANSITIONS ===\n")
print(transitions_liga)
-----------------------------------------------------------------------------
# STEP 3: Multi-State Cox Models (Separate per Transition)
# ------------------------------------------------------------------------------
# Create expanded dataset
ms_expanded_liga <- bind_rows(
# From Active
td_df_full %>%
filter(state == 0, valid_transition) %>%
mutate(trans = 1, status = as.numeric(state == 1)),
td_df_full %>%
filter(state == 0, valid_transition) %>%
mutate(trans = 2, status = as.numeric(state == 2)),
# From Injured
td_df_full %>%
filter(state == 1, valid_transition) %>%
mutate(trans = 3, status = as.numeric(state == 0)),
td_df_full %>%
filter(state == 1, valid_transition) %>%
mutate(trans = 4, status = as.numeric(state == 2))
)
# Run separate Cox models
cox_injury_liga <- coxph(
Surv(age_start, age_stop, status) ~
position_simple + region + debut_age_num +
matches_played + cluster(player_url),
data = ms_expanded_liga %>% filter(trans == 1),
method = "breslow"
)
cox_retire_direct_liga <- coxph(
Surv(age_start, age_stop, status) ~
position_simple + region + debut_age_num +
matches_played + cluster(player_url),
data = ms_expanded_liga %>% filter(trans == 2),
method = "breslow"
)
cox_recovery_liga <- coxph(
Surv(age_start, age_stop, status) ~
position_simple + region + debut_age_num + cluster(player_url),
data = ms_expanded_liga %>% filter(trans == 3),
method = "breslow"
)
cox_retire_injured_liga <- coxph(
Surv(age_start, age_stop, status) ~
position_simple + region + debut_age_num + cluster(player_url),
data = ms_expanded_liga %>% filter(trans == 4),
method = "breslow"
)
# Display results
cat("\n=== LA LIGA: Active → Injured ===\n")
print(summary(cox_injury_liga)$coefficients)
cat("\n=== LA LIGA: Active → Retired ===\n")
print(summary(cox_retire_direct_liga)$coefficients)
cat("\n=== LA LIGA: Injured → Recovered ===\n")
print(summary(cox_recovery_liga)$coefficients)
cat("\n=== LA LIGA: Injured → Retired ===\n")
print(summary(cox_retire_injured_liga)$coefficients)
td_df_full %>%
select(player_url, season_year,
age_start, age_stop,
matches_played, serious_injuries,
had_serious_last_2y, high_load,
event_dynamic, is_last_row) %>%
filter(player_url == first(player_url)) %>%
print()
